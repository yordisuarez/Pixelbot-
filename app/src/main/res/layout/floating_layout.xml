<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Minimized Pill Mode -->
    <LinearLayout
        android:id="@+id/layout_minimized_pill"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/bg_floating_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone">

        <View
            android:id="@+id/view_pill_indicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_floating_button_start" />

        <TextView
            android:id="@+id/tv_minimized_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_title"
            android:textColor="#FF00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Expanded Panel Mode -->
    <LinearLayout
        android:id="@+id/layout_expanded_panel"
        android:layout_width="268dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_panel"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <!-- Draggable Header -->
        <LinearLayout
            android:id="@+id/layout_floating_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_floating_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tv_overlay_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="@string/overlay_title"
                android:textColor="#FF00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_minimize_expand"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/overlay_btn_minimize_desc"
                android:padding="12dp"
                android:src="@android:drawable/arrow_up_float"
                android:tint="#FFCBD5E1" />

            <ImageButton
                android:id="@+id/btn_close_overlay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/overlay_btn_close_desc"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FFFF5252" />
        </LinearLayout>

        <!-- Body Controls -->
        <LinearLayout
            android:id="@+id/layout_expanded_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/overlay_map_label"
                android:textColor="#FF94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_map_target"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_floating_spinner"
                android:popupBackground="#FF131B30"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/overlay_target_label"
                android:textColor="#FF94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_alien_target"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_floating_spinner"
                android:popupBackground="#FF131B30"
                android:spinnerMode="dropdown" />

            <CheckBox
                android:id="@+id/checkbox_collect_key_boxes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#FF00E5FF"
                android:checked="false"
                android:minHeight="48dp"
                android:text="@string/overlay_collect_key_boxes"
                android:textColor="#FFE2E8F0"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/checkbox_attack_aliens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#FF00E5FF"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/overlay_attack_aliens"
                android:textColor="#FFE2E8F0"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_toggle_bot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_floating_button_start"
                android:text="@string/overlay_btn_start"
                android:textAllCaps="false"
                android:textColor="#FF050811"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_bot_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#80060A14"
                android:lineSpacingExtra="2dp"
                android:padding="8dp"
                android:text="@string/overlay_status_idle"
                android:textColor="#FF38BDF8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
